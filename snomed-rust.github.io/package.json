{
	"name": "snomed-rust.github.io",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@11.0.8",
	"engines": {
		"node": "=26"
	},
	"scripts": {
		"dev": "vite dev",
