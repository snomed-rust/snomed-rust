{
	"name": "snomed-rust.github.io",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@11.0.8",
	"engines": {
		"node": "=26"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "node scripts/gen-crates.js && (svelte-kit sync || echo '')",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"gen:crates": "node scripts/gen-crates.js"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"lily-design-system-svelte-headless": "^0.3.1",
		"lily-design-system-svelte-share-picker": "^0.1.1",
		"lily-design-system-svelte-text-size-picker": "^0.1.1",
		"lily-design-system-svelte-theme-picker": "^0.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"vite": "^8.3.4"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
