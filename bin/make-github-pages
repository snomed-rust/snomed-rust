#!/bin/sh
# Push snomed-rust.github.io/ to the `github-pages` remote via git subtree,
# per spec/monorepo-github-pages/index.md. `make github-pages` (see the
# Makefile) delegates here rather than inlining the command, so it can be
# run and read standalone like any other bin/ script.
#
# This is the plain `git subtree push` porcelain: it refuses a
# non-fast-forward outright rather than safely forcing past one. Prefer
# `make publish` day to day (dirty-tree guard, `--force-with-lease`); this
# script is the direct command for when that's what you actually want.
#
# Requires a `github-pages` remote pointing at the deployed pages repo:
#   git remote add github-pages git@github.com:snomed-rust/snomed-rust.github.io.git
#
# Run from the workspace root: bin/make-github-pages

set -eu

git subtree push --prefix=snomed-rust.github.io github-pages main
